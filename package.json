{
  "name": "breachlab",
  "version": "0.3.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fedesauzzadev/breachlab.git"
  },
  "description": "BreachLab — sandbox 100% local de un incidente de API key filtrada. Demo educativa: vulnerable por diseño, aislada en 127.0.0.1, keys 100% falsas.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "scan:secrets": "gitleaks detect --source . --no-git -c .gitleaks.toml"
  },
  "dependencies": {
    "express": "^5.1.0"
  }
}
